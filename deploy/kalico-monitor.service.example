[Unit]
Description=Kalico realtime state and Hermes alert monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
Group=YOUR_USER
EnvironmentFile=/home/YOUR_USER/.config/kalico-monitor/monitor.env
WorkingDirectory=/home/YOUR_USER/hermes-plugin-kalico-monitor
ExecStart=/home/YOUR_USER/hermes-plugin-kalico-monitor/.venv/bin/python -m kalico_monitor.monitor
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
