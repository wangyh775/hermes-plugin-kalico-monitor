# Monitor environment template: supports same-host or LAN-separated Kalico/Moonraker.
# Recommended: Hermes Gateway and Monitor on the same Linux host.
# See docs/INSTALL.zh-CN.md and docs/CONFIGURATION.zh-CN.md.
# For a remote printer, replace 127.0.0.1 with its reachable LAN address.
KALICO_PRINTER_NAME=PEEK-01
MOONRAKER_URL=http://127.0.0.1:7125
# Set only if Moonraker requires a key:
MOONRAKER_API_KEY=
HERMES_WEBHOOK_URL=http://127.0.0.1:8644/webhooks/kalico-alert
# MUST equal platforms.webhook.extra.routes.kalico-alert.secret
# Non-local HTTP Hermes Webhook URLs are rejected: use HTTPS if Gateway is remote.
HERMES_WEBHOOK_SECRET=GENERATE_A_LONG_RANDOM_SECRET
KALICO_DISCONNECT_SECONDS=25
# 0 disables stall detection (avoids false alarms during normal heating)
KALICO_STALL_MINUTES=0
# Use the same path in the Hermes plugin environment for health query.
KALICO_MONITOR_DB=/home/YOUR_USER/.local/state/kalico-monitor/alerts.sqlite3
# Optional extra restriction for /kalico; Hermes controls primary inbound permissions.
# Empty means inherit Hermes gateway permissions.
KALICO_ALLOWED_CHAT_IDS=

# Periodic printing-status reports via Hermes; 0=off, 5..1440 minutes.
# Example: 30 sends progress, elapsed print time, nozzle/bed temperatures every 30 min.
KALICO_PROGRESS_REPORT_MINUTES=0

# Optional Klippy PR #13 nozzle force anomaly alert bridge; 0=off (default).
# Enable only after Kalico has [nozzle_force_monitor] configured and validated.
KALICO_WATCH_NOZZLE_FORCE=0

# Optional LLM analysis route; required for agent/both modes.
HERMES_AGENT_WEBHOOK_URL=
# Comma-separated kind=direct|agent|both; default all events direct.
# Example: klippy_shutdown=both,nozzle_force_anomaly=both
KALICO_EVENT_MODES=
